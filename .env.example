# Copy to .env and adjust. Never commit .env.
# Every variable here is validated by a Zod schema at startup; an invalid value makes the
# service exit with code 78 rather than start half-configured.
#
# The `dev` and `migrate` scripts load this file with Node's --env-file-if-exists; nothing
# reads it at runtime, so a production container without one is configured by its orchestrator.

NODE_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL ---------------------------------------------------------------------
DATABASE_URL=postgres://nebula:nebula@localhost:5432/nebula

# --- NATS ---------------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# --- core ---------------------------------------------------------------------------
# How long an adapter has to accept a command before it is reported as unavailable.
CORE_COMMAND_TIMEOUT_MS=5000
# How long a partial batch of history rows waits before being written anyway.
CORE_HISTORY_FLUSH_INTERVAL_MS=1000
# How many history rows trigger an immediate write.
CORE_HISTORY_BATCH_SIZE=500
# How many telemetry readings are pulled from the durable stream at once.
CORE_TELEMETRY_BATCH_SIZE=500

# --- api ----------------------------------------------------------------------------
API_PORT=3001
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- proxy --------------------------------------------------------------------------
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
PROXY_TLS_MODE=self-signed
ACME_EMAIL=
ACME_DOMAIN=

# --- packet-manager -----------------------------------------------------------------
# Public npmjs.org, not GitHub Packages: GitHub requires a token even to read public
# packages, which would mean every installation needs a GitHub token just to install.
PACKAGE_REGISTRY_URL=https://registry.npmjs.org
PACKAGE_DATA_DIR=./infra/data/packages
