# Settings for docker-compose.yml. Copy this file to infra/.env and uncomment what you change;
# everything has a default and the file is optional. Compose reads it both to fill in
# docker-compose.yml and as the platform container's environment.

# --- network ------------------------------------------------------------------------
# `bridge` (the default) works everywhere, Docker Desktop included, with the page on the ports
# below; the hub cannot hear devices announce themselves there, so discovery stays off and devices
# are added by address. On a Linux server, the host's network: discovery works, the page is on the
# host's ports 8080 and 8443, and nothing needs publishing.
# NEBULA_NETWORK=host
# HUB_DISCOVERY_ENABLED=true

# The host's ports the page is published on, on the bridge.
# NEBULA_HTTP_PORT=8080
# NEBULA_HTTPS_PORT=8443

# --- the platform -------------------------------------------------------------------
# The tag of Docker Hub's nebulahome/platform the compose file runs, and builds as.
# NEBULA_IMAGE_TAG=latest

# The time zone the logs and the backups' schedule are written in.
# TZ=Europe/Rome

# LOG_LEVEL=info

# `self-signed` (the default) also serves HTTPS, with a certificate made on first start; `off`
# serves HTTP only.
# PROXY_TLS_MODE=self-signed

# The instance's keys are generated on the first start into the data volume's secrets/ folder.
# Set them here only to bring an existing installation's keys along; they then take precedence.
# NEBULA_SECRETS_KEY=
# API_TOTP_ENCRYPTION_KEY=
# API_JWT_SECRET=

# Every service connects to the database as its own role (DATABASE.md 12). `superuser` runs them
# all as the cluster's superuser, as development does.
# NEBULA_DB_ROLES=per-service

# --- MQTT ---------------------------------------------------------------------------
# The house's MQTT broker is the hub's own, inside this container: devices on the network connect
# to it on 1883, with a username added on Brokers -> MQTT. This is the host port published for it
# on the bridge (the container side is 1883).
# NEBULA_MQTT_PORT=1883
# An external broker for the integrations and the containers to use instead of the hub's:
# NEBULA_MQTT_URL=mqtt://broker.example:1883
# NEBULA_MQTT_USERNAME=
# NEBULA_MQTT_PASSWORD=

# --- packages and integrations ------------------------------------------------------
# The Community Hub's public API (no path): where the package and integrations indexes are read
# and the Install dialogs search (PACKAGES.md 10). Unset, only infra/local-packages and
# infra/local-integrations are offered. From this container a Hub running on this machine - the
# cloud-backend stack, `pnpm stack:up` - is at host.docker.internal on Docker Desktop, and at the
# machine's own address on a Linux server.
# COMMUNITY_HUB_URL=http://host.docker.internal:8088
# Whether installs from the Hub's indexes are reported to it (the house registers once). false
# sends nothing.
# COMMUNITY_HUB_REPORT_INSTALLS=true

# --- containers ---------------------------------------------------------------------
# The compose file gives the container Docker's socket, for the Containers page and the
# containers integrations need. It is root on this machine; remove the line in
# docker-compose.yml to keep Docker out of reach.
