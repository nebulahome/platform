# Settings for docker-compose.yml beside this file. Copy it to .env and uncomment what you change;
# everything has a default and the file is optional. Compose reads it both to fill in the compose
# file and as the platform container's environment.

# --- the image ----------------------------------------------------------------------
# Where the image is on Docker Hub, and which tag. An account of your own that you pushed to:
# NEBULA_IMAGE=yourname/nebulahome
# NEBULA_IMAGE_TAG=latest

# --- the page -----------------------------------------------------------------------
# On the host's network (the default) the page listens on the machine's ports directly:
# PROXY_HTTP_PORT=8080
# PROXY_HTTPS_PORT=8443

# On the bridge (docker-compose.bridge.yml), the machine's ports the page is published on:
# NEBULA_HTTP_PORT=8080
# NEBULA_HTTPS_PORT=8443

# `self-signed` (the default) also serves HTTPS, with a certificate made on first start; `off`
# serves HTTP only.
# PROXY_TLS_MODE=self-signed

# --- the data -----------------------------------------------------------------------
# A folder of this machine for the data directory, instead of the named volume nebula-data:
# NEBULA_DATA_PATH=/srv/nebulahome/data

# The time zone the logs, the backups' schedule and the containers integrations run use.
# TZ=Europe/Rome

# LOG_LEVEL=info

# --- keys ---------------------------------------------------------------------------
# Generated on the first start into the data directory's secrets/ folder. Set them here only to
# bring an existing installation's keys along; they then take precedence.
# NEBULA_SECRETS_KEY=
# API_TOTP_ENCRYPTION_KEY=
# API_JWT_SECRET=

# --- MQTT ---------------------------------------------------------------------------
# The house's MQTT broker is the hub's own; devices connect with a username added on
# Brokers -> MQTT. On the host's network it listens on 1883 (HUB_MQTT_PORT); on the bridge, on
# this host port:
# NEBULA_MQTT_PORT=1883

# --- packages and integrations ------------------------------------------------------
# The Community Hub's public API (no path), where the package and integrations indexes are read
# and the Install dialogs search. Unset, no package can be installed but what a local folder
# holds (PACKET_MANAGER_LOCAL_DIR), and no integration but what
# PACKET_MANAGER_LOCAL_INTEGRATIONS_DIR holds.
# COMMUNITY_HUB_URL=https://hub.example.com
# Whether installs from the Hub's indexes are reported to it, which counts how many houses
# installed each one. The house registers once and keeps the token sealed. false sends nothing.
# COMMUNITY_HUB_REPORT_INSTALLS=true
