#!/bin/sh
# The border router ends when its radio is unplugged or does not answer, and s6 starts it again a
# second later. A pause after a failure keeps a missing radio from writing the same error to the
# log every second until it is back; s6 gives a finish script five seconds.
if [ "$1" -ne 0 ] && [ "$1" -ne 256 ]; then
  echo "otbr-agent exited with $1: starting it again in a few seconds" >&2
  sleep 4
fi
