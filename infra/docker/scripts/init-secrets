#!/command/with-contenv sh
# Generates, once, every key and password the instance needs and the environment does not give:
# one file each in `secrets/`, mode 0600, never overwritten. The environment keeps precedence
# (nebula-env). Also the self-signed certificate `proxy` serves HTTPS with.
set -eu

secrets="${NEBULA_DATA_DIR:-/data}/secrets"
tls="${NEBULA_DATA_DIR:-/data}/proxy/tls"

umask 077

# Writes a random 32-byte secret, as hex, unless the file is already there.
generate() {
  if [ ! -s "$secrets/$1" ]; then
    openssl rand -hex 32 > "$secrets/$1.tmp"
    mv "$secrets/$1.tmp" "$secrets/$1"
    echo "init-secrets: generated $1"
  fi
}

for name in secrets-key totp-key jwt-secret postgres-password nats-password \
  db-password-nebula_core db-password-nebula_api db-password-nebula_hub \
  db-password-nebula_backup db-password-nebula_packet_manager; do
  generate "$name"
done

# Which installation this is, labelled on the containers an integration runs: not a secret, but
# made once and kept like one, so a development platform on the same Docker leaves them alone.
if [ ! -s "$secrets/installation-id" ]; then
  openssl rand -hex 8 > "$secrets/installation-id.tmp"
  mv "$secrets/installation-id.tmp" "$secrets/installation-id"
  echo "init-secrets: generated installation-id"
fi

# Made by `nebula`, who serves it, in its own folder: root cannot write there on a host that gives
# the container no CAP_DAC_OVERRIDE. The key readable by `nebula` alone, the certificate by all.
if [ "${PROXY_TLS_MODE:-self-signed}" = self-signed ] && [ ! -s "$tls/self-signed.crt" ]; then
  umask 022
  s6-setuidgid nebula openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
    -nodes -days 3650 -subj "/CN=nebulahome" \
    -addext "subjectAltName=DNS:nebulahome,DNS:nebulahome.local,DNS:localhost,IP:127.0.0.1" \
    -keyout "$tls/self-signed.key" -out "$tls/self-signed.crt" 2>/dev/null
  s6-setuidgid nebula chmod 0600 "$tls/self-signed.key"
  echo "init-secrets: generated the self-signed certificate"
fi
