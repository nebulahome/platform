#!/command/with-contenv sh
# Brings the database to what this build expects: waits for PostgreSQL, applies the migrations
# as the superuser, and sets every role's password from `secrets/` - each start, so a password
# file restored or regenerated is the one that works. An upgrade is a new image and a restart.
set -eu

. /etc/s6-overlay/scripts/nebula-env

port="${NEBULA_PG_PORT:-5433}"
socket=/var/run/postgresql

# Over TCP on purpose: while it initialises a new cluster, the image's entrypoint runs a
# temporary server on the socket only, which must not be mistaken for the real one.
tries=0
until pg_isready -q -h 127.0.0.1 -p "$port" -d nebula -U nebula; do
  tries=$((tries + 1))
  if [ "$tries" -gt 180 ]; then
    echo "init-db: PostgreSQL did not start" >&2
    exit 1
  fi
  sleep 1
done

psql -q -v ON_ERROR_STOP=1 -h "$socket" -p "$port" -U nebula -d nebula \
  -c "ALTER ROLE nebula PASSWORD '$NEBULA_PG_SUPERUSER_PASSWORD'"

DATABASE_URL="$(nebula_database_url nebula)" node /app/packages/db/dist/bin/migrate.js

for role in nebula_core nebula_api nebula_hub nebula_backup nebula_packet_manager; do
  password="$(nebula_secret "db-password-$role")"
  psql -q -v ON_ERROR_STOP=1 -h "$socket" -p "$port" -U nebula -d nebula <<SQL
DO \$\$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '$role') THEN
    EXECUTE format('ALTER ROLE %I WITH LOGIN PASSWORD %L', '$role', '$password');
  END IF;
END
\$\$;
SQL
done

echo "init-db: the database is ready"
