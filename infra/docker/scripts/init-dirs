#!/command/with-contenv sh
# The data directory's folders, owned by who writes them (ARCHITECTURE.md 14): the Node services
# run as `nebula`; `secrets/` and `backups/` belong to root, which the backup service runs as.
set -eu

data="${NEBULA_DATA_DIR:-/data}"

mkdir -p "$data/hub/integrations" "$data/proxy/tls" "$data/packages" "$data/cache/maps" \
  "$data/backups" "$data/secrets" /var/lib/nats

for folder in "$data" "$data/hub" "$data/hub/integrations" "$data/proxy" "$data/proxy/tls" \
  "$data/packages" "$data/cache" "$data/cache/maps" /var/lib/nats; do
  chown nebula:nebula "$folder"
done

chown root:root "$data/secrets" "$data/backups"
chmod 0700 "$data/secrets"
chmod 0755 "$data/backups"
