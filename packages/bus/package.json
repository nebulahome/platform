{
  "name": "@nebulahome/bus",
  "version": "2026.10.0-alpha.32",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/fake-transport.d.ts",
      "default": "./dist/fake-transport.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nebulahome/contracts": "workspace:*",
    "@nebulahome/logging": "workspace:*",
    "nats": "^2.29.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nebulahome/eslint-config": "workspace:*",
    "@nebulahome/tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  }
}
