{
  "name": "@nebulahome/package-sdk",
  "version": "1.0.0-rc.0",
  "description": "Write a NebulaHome package: declare it, build it, and run it on the platform.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "nebulahome",
    "smart-home",
    "home-automation",
    "package",
    "sdk"
  ],
  "homepage": "https://github.com/nebula-home/platform/tree/main/packages/package-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nebula-home/platform.git",
    "directory": "packages/package-sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nebulahome-package": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nebulahome/contracts": "workspace:*",
    "@nebulahome/eslint-config": "workspace:*",
    "@nebulahome/tsconfig": "workspace:*",
    "@nebulahome/ui": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "postcss": "^8.5.26",
    "publint": "^0.3.25",
    "react": "^19.2.8",
    "tar": "^7.5.22",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
