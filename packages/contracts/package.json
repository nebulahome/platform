{
  "name": "@nebula-home/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nebula-home/eslint-config": "workspace:*",
    "@nebula-home/tsconfig": "workspace:*",
    "@types/semver": "^7.7.1",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
