    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.1.1",
    "mqtt": "^5.14.1",
    "react": "^19.2.8",
