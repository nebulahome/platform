{
  "name": "@nebula-home/proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --dir tests/integration"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/http-proxy": "^11.6.1",
    "@fastify/static": "^10.1.3",
    "@nebula-home/bus": "workspace:*",
    "@nebula-home/config": "workspace:*",
    "@nebula-home/contracts": "workspace:*",
    "@nebula-home/logging": "workspace:*",
    "acme-client": "^5.4.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@nebula-home/eslint-config": "workspace:*",
    "@nebula-home/tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  }
}
