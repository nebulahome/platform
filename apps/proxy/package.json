{
  "name": "@nebulahome/proxy",
  "version": "2026.10.0-alpha.10",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --dir tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/http-proxy": "^11.6.1",
    "@fastify/static": "^10.1.3",
    "@nebulahome/config": "workspace:*",
    "@nebulahome/contracts": "workspace:*",
    "@nebulahome/logging": "workspace:*",
    "acme-client": "^5.4.0",
    "fastify": "^5.12.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nebulahome/eslint-config": "workspace:*",
    "@nebulahome/tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  }
}
