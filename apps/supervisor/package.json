{
  "name": "@nebulahome/supervisor",
  "version": "2026.10.0-alpha.31",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@nebulahome/bus": "workspace:*",
    "@nebulahome/config": "workspace:*",
    "@nebulahome/contracts": "workspace:*",
    "@nebulahome/logging": "workspace:*",
    "semver": "^7.8.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nebulahome/eslint-config": "workspace:*",
    "@nebulahome/tsconfig": "workspace:*",
    "@types/semver": "^7.7.1",
    "typescript": "^6.0.3"
  }
}
