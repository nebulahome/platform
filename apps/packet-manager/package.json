{
  "name": "@nebulahome/packet-manager",
  "version": "2026.10.0-alpha.32",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@nebulahome/bus": "workspace:*",
    "@nebulahome/config": "workspace:*",
    "@nebulahome/contracts": "workspace:*",
    "@nebulahome/db": "workspace:*",
    "@nebulahome/integration-sdk": "workspace:*",
    "@nebulahome/logging": "workspace:*",
    "@nebulahome/package-host": "workspace:*",
    "@nebulahome/package-runtime": "workspace:*",
    "@nebulahome/package-sdk": "workspace:*",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nebulahome/eslint-config": "workspace:*",
    "@nebulahome/tsconfig": "workspace:*",
    "@types/semver": "^7.7.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
