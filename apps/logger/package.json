{
  "name": "@nebula-home/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --dir tests/integration"
  },
  "dependencies": {
    "@nebula-home/bus": "workspace:*",
    "@nebula-home/config": "workspace:*",
    "@nebula-home/contracts": "workspace:*",
    "@nebula-home/db": "workspace:*",
    "@nebula-home/logging": "workspace:*",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@nebula-home/eslint-config": "workspace:*",
    "@nebula-home/tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  }
}
