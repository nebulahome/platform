{
  "name": "@nebulahome/logger",
  "version": "2026.10.0-alpha.35",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --dir tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@nebulahome/bus": "workspace:*",
    "@nebulahome/config": "workspace:*",
    "@nebulahome/contracts": "workspace:*",
    "@nebulahome/db": "workspace:*",
    "@nebulahome/logging": "workspace:*",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@nebulahome/eslint-config": "workspace:*",
    "@nebulahome/tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  }
}
