{
  "name": "@nebulahome/core",
  "version": "2026.10.0-alpha.35",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nebulahome/bus": "workspace:*",
    "@nebulahome/config": "workspace:*",
    "@nebulahome/contracts": "workspace:*",
    "@nebulahome/db": "workspace:*",
    "@nebulahome/logging": "workspace:*",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "jsonata": "^2.2.2",
    "nats": "^2.29.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nebulahome/eslint-config": "workspace:*",
    "@nebulahome/tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  }
}
