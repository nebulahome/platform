{
  "name": "@nebula-home/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --dir tests/integration"
  },
  "dependencies": {
    "@nebula-home/bus": "workspace:*",
    "@nebula-home/config": "workspace:*",
    "@nebula-home/contracts": "workspace:*",
    "@nebula-home/db": "workspace:*",
    "@nebula-home/logging": "workspace:*",
    "croner": "^10.0.1",
    "jsonata": "^2.2.2",
    "suncalc": "^2.0.2"
  },
  "devDependencies": {
    "@nebula-home/eslint-config": "workspace:*",
    "@nebula-home/tsconfig": "workspace:*",
    "@types/suncalc": "^1.9.2",
    "typescript": "^6.0.3"
  }
}
