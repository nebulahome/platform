{
  "discovery": {
    "probe": { "op": "call", "args": { "method": "Shelly.GetDeviceInfo" } },
    "claim": [
      { "path": "model", "oneOf": ["SPDM-002PE01EU"] },
      { "path": "id", "exists": true }
    ],
    "identity": { "externalId": "id", "name": "name", "model": "model", "swVersion": "ver" }
  },
  "subscriptions": [{ "op": "status", "args": { "everyMs": 60000 } }],
  "device": { "swVersion": "device_info.ver" },
  "entities": [
    {
      "domain": "light",
      "objectId": "light_1",
      "name": "Light 1",
      "icon": "light",
      "capabilities": { "on_off": {}, "level": {} },
      "state": {
        "on_off": { "isOn": "'light:0'.output" },
        "level": { "level": "'light:0'.brightness" }
      },
      "commands": {
        "on_off.turn_on": {
          "op": "call",
          "args": { "method": "Light.Set", "params": { "id": 0, "on": true } }
        },
        "on_off.turn_off": {
          "op": "call",
          "args": { "method": "Light.Set", "params": { "id": 0, "on": false } }
        },
        "on_off.toggle": {
          "op": "call",
          "args": { "method": "Light.Toggle", "params": { "id": 0 } }
        },
        "level.set_level": {
          "op": "call",
          "args": {
            "method": "Light.Set",
            "params": { "id": 0, "on": true, "brightness": { "$": "command.level" } }
          }
        }
      }
    },
    {
      "domain": "light",
      "objectId": "light_2",
      "name": "Light 2",
      "icon": "light",
      "capabilities": { "on_off": {}, "level": {} },
      "state": {
        "on_off": { "isOn": "'light:1'.output" },
        "level": { "level": "'light:1'.brightness" }
      },
      "commands": {
        "on_off.turn_on": {
          "op": "call",
          "args": { "method": "Light.Set", "params": { "id": 1, "on": true } }
        },
        "on_off.turn_off": {
          "op": "call",
          "args": { "method": "Light.Set", "params": { "id": 1, "on": false } }
        },
        "on_off.toggle": {
          "op": "call",
          "args": { "method": "Light.Toggle", "params": { "id": 1 } }
        },
        "level.set_level": {
          "op": "call",
          "args": {
            "method": "Light.Set",
            "params": { "id": 1, "on": true, "brightness": { "$": "command.level" } }
          }
        }
      }
    },
    {
      "domain": "sensor",
      "objectId": "power_1",
      "name": "Power 1",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'light:0'.apower" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "energy_1",
      "name": "Energy 1",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'light:0'.aenergy.total" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "voltage_1",
      "name": "Voltage 1",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'light:0'.voltage" } },
      "unitOfMeasurement": "V",
      "deviceClass": "voltage",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "current_1",
      "name": "Current 1",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'light:0'.current" } },
      "unitOfMeasurement": "A",
      "deviceClass": "current",
      "stateClass": "measurement",
      "displayPrecision": 3
    },
    {
      "domain": "sensor",
      "objectId": "power_2",
      "name": "Power 2",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'light:1'.apower" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "energy_2",
      "name": "Energy 2",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'light:1'.aenergy.total" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "voltage_2",
      "name": "Voltage 2",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'light:1'.voltage" } },
      "unitOfMeasurement": "V",
      "deviceClass": "voltage",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "current_2",
      "name": "Current 2",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'light:1'.current" } },
      "unitOfMeasurement": "A",
      "deviceClass": "current",
      "stateClass": "measurement",
      "displayPrecision": 3
    },
    {
      "domain": "sensor",
      "objectId": "temperature",
      "name": "Device temperature",
      "icon": "thermometer",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'light:0'.temperature.tC" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "update",
      "objectId": "firmware",
      "name": "Firmware",
      "icon": "circle-arrow-up",
      "capabilities": { "update": { "canInstall": true, "hasProgress": true } },
      "state": {
        "update": {
          "installedVersion": "device_info.ver",
          "latestVersion": "sys.available_updates.stable.version",
          "isInstalling": "ota.isInstalling",
          "progress": "ota.progress"
        }
      },
      "commands": {
        "update.install": {
          "op": "call",
          "args": { "method": "Shelly.Update", "params": { "stage": "stable" } }
        }
      }
    }
  ]
}
