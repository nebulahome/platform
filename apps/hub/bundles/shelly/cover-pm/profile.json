{
  "discovery": {
    "probe": { "op": "call", "args": { "method": "Shelly.GetDeviceInfo" } },
    "claim": [
      { "path": "model", "oneOf": ["S3SW-002P16EU", "S4SW-002P16EU"] },
      { "path": "profile", "equals": "cover" },
      { "path": "id", "exists": true }
    ],
    "identity": { "externalId": "id", "name": "name", "model": "model", "swVersion": "ver" }
  },
  "subscriptions": [{ "op": "status", "args": { "everyMs": 60000 } }],
  "entities": [
    {
      "domain": "cover",
      "objectId": "cover",
      "name": "Cover",
      "icon": "blinds",
      "capabilities": { "cover": { "hasPosition": true, "hasTilt": false } },
      "state": {
        "cover": {
          "position": "'cover:0'.current_pos",
          "motion": {
            "path": "'cover:0'.state",
            "map": { "opening": "opening", "closing": "closing" },
            "default": "stopped"
          }
        }
      },
      "commands": {
        "cover.open": { "op": "call", "args": { "method": "Cover.Open", "params": { "id": 0 } } },
        "cover.close": { "op": "call", "args": { "method": "Cover.Close", "params": { "id": 0 } } },
        "cover.stop": { "op": "call", "args": { "method": "Cover.Stop", "params": { "id": 0 } } },
        "cover.set_position": {
          "op": "call",
          "args": {
            "method": "Cover.GoToPosition",
            "params": { "id": 0, "pos": { "$": "command.position" } }
          }
        }
      }
    },
    {
      "domain": "sensor",
      "objectId": "power",
      "name": "Power",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'cover:0'.apower" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "energy",
      "name": "Energy",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'cover:0'.aenergy.total" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "voltage",
      "name": "Voltage",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'cover:0'.voltage" } },
      "unitOfMeasurement": "V",
      "deviceClass": "voltage",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "current",
      "name": "Current",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'cover:0'.current" } },
      "unitOfMeasurement": "A",
      "deviceClass": "current",
      "stateClass": "measurement",
      "displayPrecision": 3
    },
    {
      "domain": "sensor",
      "objectId": "temperature",
      "name": "Device temperature",
      "icon": "thermometer",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'cover:0'.temperature.tC" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "binary_sensor",
      "objectId": "firmware",
      "name": "Firmware update",
      "icon": "circle-arrow-up",
      "capabilities": { "sensor_binary": {} },
      "state": {
        "sensor_binary": { "isOn": { "path": "sys.available_updates.stable", "present": true } }
      },
      "deviceClass": "update"
    },
    {
      "domain": "button",
      "objectId": "firmware_install",
      "name": "Install firmware update",
      "icon": "download",
      "capabilities": { "button": {} },
      "state": {},
      "commands": {
        "button.press": {
          "op": "call",
          "args": { "method": "Shelly.Update", "params": { "stage": "stable" } }
        }
      },
      "deviceClass": "update"
    }
  ]
}
