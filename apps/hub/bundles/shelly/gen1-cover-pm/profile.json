{
  "discovery": {
    "probe": { "op": "get", "args": { "path": "/shelly" } },
    "claim": [
      { "path": "type", "oneOf": ["SHSW-25"] },
      { "path": "mode", "equals": "roller" },
      { "path": "mac", "exists": true }
    ],
    "identity": { "externalId": "mac", "model": "type", "swVersion": "fw" }
  },
  "subscriptions": [{ "op": "poll", "args": { "everyMs": 30000 } }],
  "device": { "swVersion": "update.old_version" },
  "entities": [
    {
      "domain": "cover",
      "objectId": "cover",
      "name": "Cover",
      "icon": "blinds",
      "capabilities": { "cover": { "hasPosition": true, "hasTilt": false } },
      "state": {
        "cover": {
          "position": "rollers[0].current_pos",
          "motion": {
            "path": "rollers[0].state",
            "map": { "open": "opening", "close": "closing" },
            "default": "stopped"
          }
        }
      },
      "commands": {
        "cover.open": { "op": "get", "args": { "path": "/roller/0", "query": { "go": "open" } } },
        "cover.close": { "op": "get", "args": { "path": "/roller/0", "query": { "go": "close" } } },
        "cover.stop": { "op": "get", "args": { "path": "/roller/0", "query": { "go": "stop" } } },
        "cover.set_position": {
          "op": "get",
          "args": {
            "path": "/roller/0",
            "query": { "go": "to_pos", "roller_pos": { "$": "command.position" } }
          }
        }
      }
    },
    {
      "domain": "sensor",
      "objectId": "power",
      "name": "Power",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "rollers[0].power" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "temperature",
      "name": "Device temperature",
      "icon": "thermometer",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "tmp.tC" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "update",
      "objectId": "firmware",
      "name": "Firmware",
      "icon": "circle-arrow-up",
      "capabilities": { "update": { "canInstall": true, "hasProgress": false } },
      "state": {
        "update": {
          "installedVersion": "update.old_version",
          "latestVersion": "update.new_version",
          "isInstalling": { "path": "update.status", "map": { "updating": true }, "default": false }
        }
      },
      "commands": {
        "update.install": { "op": "get", "args": { "path": "/ota", "query": { "update": true } } }
      }
    }
  ]
}
