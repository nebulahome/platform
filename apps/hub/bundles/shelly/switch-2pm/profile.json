{
  "discovery": {
    "probe": { "op": "call", "args": { "method": "Shelly.GetDeviceInfo" } },
    "claim": [
      {
        "path": "model",
        "oneOf": [
          "S3SW-002P16EU",
          "S4SW-002P16EU",
          "SNSW-002P16EU",
          "SNSW-102P16EU",
          "SNSW-002P15UL",
          "SPSW-002PE16EU",
          "SPSW-102PE16EU",
          "SPSW-202PE16EU"
        ]
      },
      { "path": "profile", "equals": "switch" },
      { "path": "id", "exists": true }
    ],
    "identity": { "externalId": "id", "name": "name", "model": "model", "swVersion": "ver" }
  },
  "subscriptions": [{ "op": "status", "args": { "everyMs": 60000 } }],
  "entities": [
    {
      "domain": "switch",
      "objectId": "switch_1",
      "name": "Switch 1",
      "icon": "switch",
      "capabilities": { "on_off": {} },
      "state": { "on_off": { "isOn": "'switch:0'.output" } },
      "commands": {
        "on_off.turn_on": {
          "op": "call",
          "args": { "method": "Switch.Set", "params": { "id": 0, "on": true } }
        },
        "on_off.turn_off": {
          "op": "call",
          "args": { "method": "Switch.Set", "params": { "id": 0, "on": false } }
        },
        "on_off.toggle": {
          "op": "call",
          "args": { "method": "Switch.Toggle", "params": { "id": 0 } }
        }
      }
    },
    {
      "domain": "switch",
      "objectId": "switch_2",
      "name": "Switch 2",
      "icon": "switch",
      "capabilities": { "on_off": {} },
      "state": { "on_off": { "isOn": "'switch:1'.output" } },
      "commands": {
        "on_off.turn_on": {
          "op": "call",
          "args": { "method": "Switch.Set", "params": { "id": 1, "on": true } }
        },
        "on_off.turn_off": {
          "op": "call",
          "args": { "method": "Switch.Set", "params": { "id": 1, "on": false } }
        },
        "on_off.toggle": {
          "op": "call",
          "args": { "method": "Switch.Toggle", "params": { "id": 1 } }
        }
      }
    },
    {
      "domain": "sensor",
      "objectId": "power_1",
      "name": "Power 1",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'switch:0'.apower" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "energy_1",
      "name": "Energy 1",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'switch:0'.aenergy.total" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "voltage_1",
      "name": "Voltage 1",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'switch:0'.voltage" } },
      "unitOfMeasurement": "V",
      "deviceClass": "voltage",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "current_1",
      "name": "Current 1",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'switch:0'.current" } },
      "unitOfMeasurement": "A",
      "deviceClass": "current",
      "stateClass": "measurement",
      "displayPrecision": 3
    },
    {
      "domain": "sensor",
      "objectId": "power_2",
      "name": "Power 2",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'switch:1'.apower" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "energy_2",
      "name": "Energy 2",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'switch:1'.aenergy.total" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "voltage_2",
      "name": "Voltage 2",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'switch:1'.voltage" } },
      "unitOfMeasurement": "V",
      "deviceClass": "voltage",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "current_2",
      "name": "Current 2",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'switch:1'.current" } },
      "unitOfMeasurement": "A",
      "deviceClass": "current",
      "stateClass": "measurement",
      "displayPrecision": 3
    },
    {
      "domain": "sensor",
      "objectId": "temperature",
      "name": "Device temperature",
      "icon": "thermometer",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'switch:0'.temperature.tC" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "binary_sensor",
      "objectId": "firmware",
      "name": "Firmware update",
      "icon": "circle-arrow-up",
      "capabilities": { "sensor_binary": {} },
      "state": {
        "sensor_binary": { "isOn": { "path": "sys.available_updates.stable", "present": true } }
      },
      "deviceClass": "update"
    },
    {
      "domain": "button",
      "objectId": "firmware_install",
      "name": "Install firmware update",
      "icon": "download",
      "capabilities": { "button": {} },
      "state": {},
      "commands": {
        "button.press": {
          "op": "call",
          "args": { "method": "Shelly.Update", "params": { "stage": "stable" } }
        }
      },
      "deviceClass": "update"
    }
  ]
}
