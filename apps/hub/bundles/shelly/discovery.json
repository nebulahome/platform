{
  "listen": [{ "mdns": "_shelly._tcp" }, { "mdns": "_http._tcp" }],
  "match": [{ "path": "instance", "startsWith": "shelly" }],
  "probe": {
    "transport": "http",
    "op": "get",
    "args": { "path": "/shelly" },
    "timeoutMs": 10000
  },
  "identity": {
    "externalId": ["id", "mac"],
    "name": "name",
    "model": ["model", "type"],
    "swVersion": ["ver", "fw"]
  }
}
