{
  "discovery": {
    "probe": { "op": "call", "args": { "method": "Shelly.GetDeviceInfo" } },
    "claim": [
      { "path": "model", "oneOf": ["S4EM-001PXCEU16"] },
      { "path": "id", "exists": true }
    ],
    "identity": { "externalId": "id", "name": "name", "model": "model", "swVersion": "ver" }
  },
  "subscriptions": [{ "op": "status", "args": { "everyMs": 60000 } }],
  "device": { "swVersion": "device_info.ver" },
  "entities": [
    {
      "domain": "sensor",
      "objectId": "power",
      "name": "Power",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.act_power" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "voltage",
      "name": "Voltage",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.voltage" } },
      "unitOfMeasurement": "V",
      "deviceClass": "voltage",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "current",
      "name": "Current",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.current" } },
      "unitOfMeasurement": "A",
      "deviceClass": "current",
      "stateClass": "measurement",
      "displayPrecision": 3
    },
    {
      "domain": "sensor",
      "objectId": "power_factor",
      "name": "Power factor",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.pf" } },
      "deviceClass": "power_factor",
      "stateClass": "measurement",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "energy",
      "name": "Energy",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1data:0'.total_act_energy" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "energy_returned",
      "name": "Energy returned",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1data:0'.total_act_ret_energy" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "frequency",
      "name": "Frequency",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.freq" } },
      "unitOfMeasurement": "Hz",
      "deviceClass": "frequency",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "update",
      "objectId": "firmware",
      "name": "Firmware",
      "icon": "circle-arrow-up",
      "capabilities": { "update": { "canInstall": true, "hasProgress": true } },
      "state": {
        "update": {
          "installedVersion": "device_info.ver",
          "latestVersion": "sys.available_updates.stable.version",
          "isInstalling": "ota.isInstalling",
          "progress": "ota.progress"
        }
      },
      "commands": {
        "update.install": {
          "op": "call",
          "args": { "method": "Shelly.Update", "params": { "stage": "stable" } }
        }
      }
    }
  ]
}
