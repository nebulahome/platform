{
  "discovery": {
    "probe": { "op": "get", "args": { "path": "/shelly" } },
    "claim": [
      { "path": "type", "oneOf": ["SHSW-25"] },
      { "path": "mode", "equals": "relay" },
      { "path": "mac", "exists": true }
    ],
    "identity": { "externalId": "mac", "model": "type", "swVersion": "fw" }
  },
  "subscriptions": [{ "op": "poll", "args": { "everyMs": 30000 } }],
  "entities": [
    {
      "domain": "switch",
      "objectId": "switch_1",
      "name": "Switch 1",
      "icon": "switch",
      "capabilities": { "on_off": {} },
      "state": { "on_off": { "isOn": "relays[0].ison" } },
      "commands": {
        "on_off.turn_on": {
          "op": "get",
          "args": { "path": "/relay/0", "query": { "turn": "on" } }
        },
        "on_off.turn_off": {
          "op": "get",
          "args": { "path": "/relay/0", "query": { "turn": "off" } }
        },
        "on_off.toggle": {
          "op": "get",
          "args": { "path": "/relay/0", "query": { "turn": "toggle" } }
        }
      }
    },
    {
      "domain": "switch",
      "objectId": "switch_2",
      "name": "Switch 2",
      "icon": "switch",
      "capabilities": { "on_off": {} },
      "state": { "on_off": { "isOn": "relays[1].ison" } },
      "commands": {
        "on_off.turn_on": {
          "op": "get",
          "args": { "path": "/relay/1", "query": { "turn": "on" } }
        },
        "on_off.turn_off": {
          "op": "get",
          "args": { "path": "/relay/1", "query": { "turn": "off" } }
        },
        "on_off.toggle": {
          "op": "get",
          "args": { "path": "/relay/1", "query": { "turn": "toggle" } }
        }
      }
    },
    {
      "domain": "sensor",
      "objectId": "power_1",
      "name": "Power 1",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "meters[0].power" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "energy_1",
      "name": "Energy 1",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "meters[0].total_wh" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "power_2",
      "name": "Power 2",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "meters[1].power" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "energy_2",
      "name": "Energy 2",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "meters[1].total_wh" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "temperature",
      "name": "Device temperature",
      "icon": "thermometer",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "tmp.tC" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "binary_sensor",
      "objectId": "firmware",
      "name": "Firmware update",
      "icon": "circle-arrow-up",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": "update.has_update" } },
      "deviceClass": "update"
    },
    {
      "domain": "button",
      "objectId": "firmware_install",
      "name": "Install firmware update",
      "icon": "download",
      "capabilities": { "button": {} },
      "state": {},
      "commands": {
        "button.press": { "op": "get", "args": { "path": "/ota", "query": { "update": true } } }
      },
      "deviceClass": "update"
    }
  ]
}
