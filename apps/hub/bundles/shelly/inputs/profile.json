{
  "discovery": {
    "probe": { "op": "call", "args": { "method": "Shelly.GetDeviceInfo" } },
    "claim": [
      { "path": "model", "oneOf": ["S3SN-0024X", "S4SN-0A24X", "SNSN-0024X", "SNSN-0D24X"] },
      { "path": "id", "exists": true }
    ],
    "identity": { "externalId": "id", "name": "name", "model": "model", "swVersion": "ver" }
  },
  "subscriptions": [{ "op": "status", "args": { "everyMs": 60000 } }],
  "device": { "swVersion": "device_info.ver" },
  "entities": [
    {
      "domain": "binary_sensor",
      "objectId": "input_1",
      "name": "Input 1",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": "'input:0'.state" } }
    },
    {
      "domain": "binary_sensor",
      "objectId": "input_2",
      "name": "Input 2",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": "'input:1'.state" } }
    },
    {
      "domain": "binary_sensor",
      "objectId": "input_3",
      "name": "Input 3",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": "'input:2'.state" } }
    },
    {
      "domain": "binary_sensor",
      "objectId": "input_4",
      "name": "Input 4",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": "'input:3'.state" } }
    },
    {
      "domain": "update",
      "objectId": "firmware",
      "name": "Firmware",
      "icon": "circle-arrow-up",
      "capabilities": { "update": { "canInstall": true, "hasProgress": true } },
      "state": {
        "update": {
          "installedVersion": "device_info.ver",
          "latestVersion": "sys.available_updates.stable.version",
          "isInstalling": "ota.isInstalling",
          "progress": "ota.progress"
        }
      },
      "commands": {
        "update.install": {
          "op": "call",
          "args": { "method": "Shelly.Update", "params": { "stage": "stable" } }
        }
      }
    }
  ]
}
