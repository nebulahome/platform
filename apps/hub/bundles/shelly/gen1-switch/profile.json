{
  "discovery": {
    "probe": { "op": "get", "args": { "path": "/shelly" } },
    "claim": [
      { "path": "type", "oneOf": ["SHSW-1"] },
      { "path": "mac", "exists": true }
    ],
    "identity": { "externalId": "mac", "model": "type", "swVersion": "fw" }
  },
  "subscriptions": [{ "op": "poll", "args": { "everyMs": 30000 } }],
  "device": { "swVersion": "update.old_version" },
  "entities": [
    {
      "domain": "switch",
      "objectId": "switch",
      "name": "Switch",
      "icon": "switch",
      "capabilities": { "on_off": {} },
      "state": { "on_off": { "isOn": "relays[0].ison" } },
      "commands": {
        "on_off.turn_on": {
          "op": "get",
          "args": { "path": "/relay/0", "query": { "turn": "on" } }
        },
        "on_off.turn_off": {
          "op": "get",
          "args": { "path": "/relay/0", "query": { "turn": "off" } }
        },
        "on_off.toggle": {
          "op": "get",
          "args": { "path": "/relay/0", "query": { "turn": "toggle" } }
        }
      }
    },
    {
      "domain": "update",
      "objectId": "firmware",
      "name": "Firmware",
      "icon": "circle-arrow-up",
      "capabilities": { "update": { "canInstall": true, "hasProgress": false } },
      "state": {
        "update": {
          "installedVersion": "update.old_version",
          "latestVersion": "update.new_version",
          "isInstalling": { "path": "update.status", "map": { "updating": true }, "default": false }
        }
      },
      "commands": {
        "update.install": { "op": "get", "args": { "path": "/ota", "query": { "update": true } } }
      }
    }
  ]
}
