{
  "discovery": {
    "probe": { "op": "call", "args": { "method": "Shelly.GetDeviceInfo" } },
    "claim": [
      { "path": "model", "oneOf": ["SPSW-004PE16EU", "SPSW-104PE16EU", "SPSW-204PE16EU"] },
      { "path": "id", "exists": true }
    ],
    "identity": { "externalId": "id", "name": "name", "model": "model", "swVersion": "ver" }
  },
  "subscriptions": [{ "op": "status", "args": { "everyMs": 60000 } }],
  "device": { "swVersion": "device_info.ver" },
  "entities": [
    {
      "domain": "switch",
      "objectId": "switch_1",
      "name": "Switch 1",
      "icon": "switch",
      "capabilities": { "on_off": {} },
      "state": { "on_off": { "isOn": "'switch:0'.output" } },
      "commands": {
        "on_off.turn_on": {
          "op": "call",
          "args": { "method": "Switch.Set", "params": { "id": 0, "on": true } }
        },
        "on_off.turn_off": {
          "op": "call",
          "args": { "method": "Switch.Set", "params": { "id": 0, "on": false } }
        },
        "on_off.toggle": {
          "op": "call",
          "args": { "method": "Switch.Toggle", "params": { "id": 0 } }
        }
      }
    },
    {
      "domain": "switch",
      "objectId": "switch_2",
      "name": "Switch 2",
      "icon": "switch",
      "capabilities": { "on_off": {} },
