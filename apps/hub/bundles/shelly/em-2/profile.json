{
  "discovery": {
    "probe": { "op": "call", "args": { "method": "Shelly.GetDeviceInfo" } },
    "claim": [
      { "path": "model", "oneOf": ["S3EM-002CXCEU", "S4EM-002CXCEU"] },
      { "path": "id", "exists": true }
    ],
    "identity": { "externalId": "id", "name": "name", "model": "model", "swVersion": "ver" }
  },
  "subscriptions": [{ "op": "status", "args": { "everyMs": 60000 } }],
  "entities": [
    {
      "domain": "switch",
      "objectId": "switch",
      "name": "Switch",
      "icon": "switch",
      "capabilities": { "on_off": {} },
      "state": { "on_off": { "isOn": "'switch:0'.output" } },
      "commands": {
        "on_off.turn_on": {
          "op": "call",
          "args": { "method": "Switch.Set", "params": { "id": 0, "on": true } }
        },
        "on_off.turn_off": {
          "op": "call",
          "args": { "method": "Switch.Set", "params": { "id": 0, "on": false } }
        },
        "on_off.toggle": {
          "op": "call",
          "args": { "method": "Switch.Toggle", "params": { "id": 0 } }
        }
      }
    },
    {
      "domain": "sensor",
      "objectId": "power_1",
      "name": "Power 1",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.act_power" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "voltage_1",
      "name": "Voltage 1",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.voltage" } },
      "unitOfMeasurement": "V",
      "deviceClass": "voltage",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "current_1",
      "name": "Current 1",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.current" } },
      "unitOfMeasurement": "A",
      "deviceClass": "current",
      "stateClass": "measurement",
      "displayPrecision": 3
    },
    {
      "domain": "sensor",
      "objectId": "power_factor_1",
      "name": "Power factor 1",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.pf" } },
      "deviceClass": "power_factor",
      "stateClass": "measurement",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "energy_1",
      "name": "Energy 1",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1data:0'.total_act_energy" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "energy_returned_1",
      "name": "Energy returned 1",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1data:0'.total_act_ret_energy" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "frequency",
      "name": "Frequency",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:0'.freq" } },
      "unitOfMeasurement": "Hz",
      "deviceClass": "frequency",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "power_2",
      "name": "Power 2",
      "icon": "zap",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:1'.act_power" } },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "voltage_2",
      "name": "Voltage 2",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:1'.voltage" } },
      "unitOfMeasurement": "V",
      "deviceClass": "voltage",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "current_2",
      "name": "Current 2",
      "icon": "activity",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:1'.current" } },
      "unitOfMeasurement": "A",
      "deviceClass": "current",
      "stateClass": "measurement",
      "displayPrecision": 3
    },
    {
      "domain": "sensor",
      "objectId": "power_factor_2",
      "name": "Power factor 2",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1:1'.pf" } },
      "deviceClass": "power_factor",
      "stateClass": "measurement",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "energy_2",
      "name": "Energy 2",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1data:1'.total_act_energy" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "energy_returned_2",
      "name": "Energy returned 2",
      "icon": "energy",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "'em1data:1'.total_act_ret_energy" } },
      "unitOfMeasurement": "Wh",
      "deviceClass": "energy",
      "stateClass": "total_increasing",
      "displayPrecision": 2
    }
  ]
}
