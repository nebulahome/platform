{
  "discovery": {
    "probe": { "op": "get", "args": { "path": "/shelly" } },
    "claim": [
      { "path": "type", "oneOf": ["SHIX3-1"] },
      { "path": "mac", "exists": true }
    ],
    "identity": { "externalId": "mac", "model": "type", "swVersion": "fw" }
  },
  "subscriptions": [{ "op": "poll", "args": { "everyMs": 30000 } }],
  "entities": [
    {
      "domain": "binary_sensor",
      "objectId": "input_1",
      "name": "Input 1",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": { "path": "inputs[0].input", "equals": 1 } } }
    },
    {
      "domain": "binary_sensor",
      "objectId": "input_2",
      "name": "Input 2",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": { "path": "inputs[1].input", "equals": 1 } } }
    },
    {
      "domain": "binary_sensor",
      "objectId": "input_3",
      "name": "Input 3",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": { "path": "inputs[2].input", "equals": 1 } } }
    },
    {
      "domain": "binary_sensor",
      "objectId": "firmware",
      "name": "Firmware update",
      "icon": "circle-arrow-up",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": "update.has_update" } },
      "deviceClass": "update"
    },
    {
      "domain": "button",
      "objectId": "firmware_install",
      "name": "Install firmware update",
      "icon": "download",
      "capabilities": { "button": {} },
      "state": {},
      "commands": {
        "button.press": { "op": "get", "args": { "path": "/ota", "query": { "update": true } } }
      },
      "deviceClass": "update"
    }
  ]
}
