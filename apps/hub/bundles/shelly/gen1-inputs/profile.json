{
  "discovery": {
    "probe": { "op": "get", "args": { "path": "/shelly" } },
    "claim": [
      { "path": "type", "oneOf": ["SHIX3-1"] },
      { "path": "mac", "exists": true }
    ],
    "identity": { "externalId": "mac", "model": "type", "swVersion": "fw" }
  },
  "subscriptions": [{ "op": "poll", "args": { "everyMs": 30000 } }],
  "device": { "swVersion": "update.old_version" },
  "entities": [
    {
      "domain": "binary_sensor",
      "objectId": "input_1",
      "name": "Input 1",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": { "path": "inputs[0].input", "equals": 1 } } }
    },
    {
      "domain": "binary_sensor",
      "objectId": "input_2",
      "name": "Input 2",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": { "path": "inputs[1].input", "equals": 1 } } }
    },
    {
      "domain": "binary_sensor",
      "objectId": "input_3",
      "name": "Input 3",
      "icon": "toggle-left",
      "capabilities": { "sensor_binary": {} },
      "state": { "sensor_binary": { "isOn": { "path": "inputs[2].input", "equals": 1 } } }
    },
    {
      "domain": "update",
      "objectId": "firmware",
      "name": "Firmware",
      "icon": "circle-arrow-up",
      "capabilities": { "update": { "canInstall": true, "hasProgress": false } },
      "state": {
        "update": {
          "installedVersion": "update.old_version",
          "latestVersion": "update.new_version",
          "isInstalling": { "path": "update.status", "map": { "updating": true }, "default": false }
        }
      },
      "commands": {
        "update.install": { "op": "get", "args": { "path": "/ota", "query": { "update": true } } }
      }
    }
  ]
}
