{
  "discovery": {
    "claim": [
      { "path": "device", "exists": true },
      { "path": "sku", "exists": true }
    ],
    "identity": { "externalId": "device", "model": "sku", "swVersion": "wifiVersionSoft" }
  },
  "subscriptions": [{ "op": "poll", "args": { "everyMs": 10000 } }],
  "entities": [
    {
      "domain": "light",
      "icon": "light",
      "capabilities": {
        "on_off": {},
        "level": {},
        "color_temp": { "minMireds": 111, "maxMireds": 500 }
      },
      "state": {
        "on_off": { "isOn": { "path": "onOff", "equals": 1 } },
        "level": { "level": "brightness" },
        "color_temp": { "mireds": "mireds" }
      },
      "commands": {
        "on_off.turn_on": { "op": "turn", "args": { "value": 1 } },
        "on_off.turn_off": { "op": "turn", "args": { "value": 0 } },
        "level.set_level": { "op": "brightness", "args": { "value": { "$": "command.level" } } },
        "color_temp.set_color_temp": {
          "op": "colortemp",
          "args": { "mireds": { "$": "command.mireds" } }
        }
      }
    }
  ]
}
