{
  "name": "ECOVACS HOME account",
  "help": "The account the ECOVACS HOME app signs in with. The first time, ECOVACS emails a code to confirm NebulaHome; from then on the password is enough.",
  "fields": {
    "fields": [
      {
        "key": "email",
        "type": "text",
        "label": "ECOVACS account",
        "help": "The email you sign in to the ECOVACS HOME app with. The GOATs and DEEBOTs bound to it are added on their own.",
        "placeholder": "you@example.com",
        "isRequired": true,
        "maxLength": 256,
        "pattern": "^[^@\\s]+@[^@\\s]+$",
        "patternMessage": "The account's email address"
      },
      {
        "key": "password",
        "type": "secret",
        "label": "Password",
        "help": "The ECOVACS HOME app's password. Kept sealed; only its digest is sent, to ECOVACS's sign-in.",
        "isRequired": true,
        "maxLength": 256
      },
