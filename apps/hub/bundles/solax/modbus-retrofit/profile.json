{
  "discovery": {
    "claim": [
      {
        "path": "family",
        "oneOf": ["ac_g3_x1", "ac_g3_x3", "ac_g4_x1", "ac_g4_x3"]
      },
      {
        "path": "serial",
        "exists": true
      }
    ],
    "identity": {
      "externalId": "serial",
      "model": "model"
    }
  },
  "subscriptions": [
    {
      "op": "poll",
      "args": {
        "everyMs": 15000,
        "family": {
          "$": "family"
        },
        "protocol": {
          "$": "protocol"
        }
      }
    }
  ],
  "entities": [
    {
      "domain": "sensor",
      "objectId": "ac_power",
      "name": "Output power",
      "icon": "energy",
      "capabilities": {
        "sensor_numeric": {}
      },
      "state": {
        "sensor_numeric": {
          "value": "values.ac_power"
        }
      },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 0
    },
    {
      "domain": "sensor",
      "objectId": "grid_frequency",
      "name": "Grid frequency",
      "icon": "activity",
      "capabilities": {
        "sensor_numeric": {}
      },
      "state": {
        "sensor_numeric": {
          "value": "values.grid_frequency"
        }
      },
      "unitOfMeasurement": "Hz",
      "deviceClass": "frequency",
      "stateClass": "measurement",
      "displayPrecision": 2
    },
    {
      "domain": "sensor",
      "objectId": "grid_power",
      "name": "Feed-in power",
      "icon": "utility-pole",
      "capabilities": {
        "sensor_numeric": {}
      },
      "state": {
        "sensor_numeric": {
          "value": "values.grid_power"
        }
      },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 0
    },
    {
      "domain": "sensor",
      "objectId": "battery_power",
      "name": "Battery power",
      "icon": "battery-charging",
      "capabilities": {
        "sensor_numeric": {}
      },
      "state": {
        "sensor_numeric": {
          "value": "values.battery_power"
        }
      },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 0
    },
    {
      "domain": "sensor",
      "objectId": "battery_soc",
      "name": "Battery level",
      "icon": "battery",
      "capabilities": {
        "sensor_numeric": {}
      },
      "state": {
