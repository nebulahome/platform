{
  "discovery": {
    "claim": [
      {
        "path": "family",
        "oneOf": ["x3_evc"]
      },
      {
        "path": "sn",
        "exists": true
      }
    ],
    "identity": {
      "externalId": "sn",
      "manufacturer": "manufacturer",
      "model": "model",
      "swVersion": "ver"
    }
  },
  "subscriptions": [
    {
      "op": "poll",
      "args": {
        "everyMs": 30000
      }
    }
  ],
  "entities": [
    {
      "domain": "sensor",
      "objectId": "ac_power",
      "name": "Charging power",
      "icon": "ev-charger",
      "capabilities": {
        "sensor_numeric": {}
      },
      "state": {
        "sensor_numeric": {
          "value": "values.ac_power"
        }
      },
      "unitOfMeasurement": "W",
      "deviceClass": "power",
      "stateClass": "measurement",
      "displayPrecision": 0
    },
    {
