{
  "discovery": {
    "scan": { "filter": "device/+/report" },
    "claim": [
      { "path": "message.print", "exists": true },
      { "path": "segments[1]", "exists": true }
    ],
    "identity": {
      "externalId": "segments[1]"
    }
  },
  "subscriptions": [
    { "op": "topic", "args": { "filter": ["device", { "$": "segments[1]" }, "report"] } },
    {
      "op": "publish",
      "args": {
        "topic": ["device", { "$": "segments[1]" }, "request"],
        "payload": {
          "pushing": { "sequence_id": "0", "command": "pushall", "version": 1, "push_target": 1 }
        },
        "everyMs": 300000
      }
    }
  ],

  "entities": [
    {
      "domain": "light",
      "objectId": "chamber_light",
      "name": "Chamber light",
      "icon": "light",
      "capabilities": { "on_off": {} },
      "state": {
        "on_off": { "isOn": { "path": "message.print.lights_report[0].mode", "equals": "on" } }
      },
      "commands": {
        "on_off.turn_on": {
          "op": "publish",
          "args": {
            "topic": ["device", { "$": "device.segments[1]" }, "request"],
            "payload": {
              "system": {
                "sequence_id": "0",
                "command": "ledctrl",
                "led_node": "chamber_light",
                "led_mode": "on",
                "led_on_time": 500,
                "led_off_time": 500,
                "loop_times": 0,
                "interval_time": 0
              }
            }
          }
        },
        "on_off.turn_off": {
          "op": "publish",
          "args": {
            "topic": ["device", { "$": "device.segments[1]" }, "request"],
            "payload": {
              "system": {
                "sequence_id": "0",
                "command": "ledctrl",
                "led_node": "chamber_light",
                "led_mode": "off",
                "led_on_time": 500,
                "led_off_time": 500,
                "loop_times": 0,
                "interval_time": 0
              }
            }
          }
        }
      }
    },

    {
      "domain": "sensor",
      "objectId": "nozzle_temperature",
      "name": "Nozzle temperature",
      "icon": "thermometer",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.nozzle_temper" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 1
    },

    {
      "domain": "sensor",
      "objectId": "nozzle_target_temperature",
      "name": "Nozzle target",
      "icon": "thermometer",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.nozzle_target_temper" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 0
    },

    {
      "domain": "sensor",
      "objectId": "bed_temperature",
      "name": "Bed temperature",
      "icon": "heater",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.bed_temper" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 1
    },

    {
      "domain": "sensor",
      "objectId": "bed_target_temperature",
      "name": "Bed target",
      "icon": "heater",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.bed_target_temper" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 0
    },

    {
      "domain": "sensor",
      "objectId": "chamber_temperature",
      "name": "Chamber temperature",
      "icon": "thermometer",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.chamber_temper" } },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 0
    },

    {
      "domain": "binary_sensor",
      "objectId": "printing",
      "name": "Printing",
      "icon": "printer",
      "capabilities": { "sensor_binary": {} },
      "state": {
        "sensor_binary": { "isOn": { "path": "message.print.gcode_state", "equals": "RUNNING" } }
      },
      "deviceClass": "running"
    },

    {
      "domain": "sensor",
      "objectId": "print_progress",
      "name": "Print progress",
      "icon": "percent",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.mc_percent" } },
      "unitOfMeasurement": "%",
      "stateClass": "measurement",
      "displayPrecision": 0
    },

    {
      "domain": "sensor",
      "objectId": "remaining_time",
      "name": "Remaining time",
      "icon": "timer",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.mc_remaining_time" } },
      "unitOfMeasurement": "min",
      "deviceClass": "duration",
      "stateClass": "measurement",
      "displayPrecision": 0
    },

    {
      "domain": "sensor",
      "objectId": "layer",
      "name": "Layer",
      "icon": "layers",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.layer_num" } },
      "stateClass": "measurement",
      "displayPrecision": 0
    },

    {
      "domain": "sensor",
      "objectId": "total_layers",
      "name": "Total layers",
      "icon": "layers",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.total_layer_num" } },
      "stateClass": "measurement",
      "displayPrecision": 0
    },

    {
      "domain": "sensor",
      "objectId": "speed_level",
      "name": "Speed level",
      "icon": "gauge",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "message.print.spd_lvl" } },
      "stateClass": "measurement",
      "displayPrecision": 0
    }
  ]
}
