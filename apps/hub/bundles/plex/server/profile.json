{
  "discovery": {
    "probe": { "op": "get", "args": { "path": "/identity" } },
    "claim": [{ "path": "MediaContainer.machineIdentifier", "exists": true }],
    "identity": {
      "externalId": "MediaContainer.machineIdentifier",
      "swVersion": "MediaContainer.version"
    }
  },
  "subscriptions": [{ "op": "poll", "args": { "path": "/status/sessions", "everyMs": 15000 } }],
  "entities": [
    {
      "domain": "sensor",
      "objectId": "activity",
      "name": "Activity",
      "icon": "play",
      "capabilities": { "sensor_numeric": {} },
      "state": { "sensor_numeric": { "value": "MediaContainer.size" } },
      "stateClass": "measurement",
      "displayPrecision": 0
    }
  ]
}
